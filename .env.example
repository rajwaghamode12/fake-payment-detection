# .env.example
# Copy this file to .env and update the values before running in production.

# Flask secret key – CHANGE THIS in production to a long random string
SECRET_KEY=dev-secret-key-change-in-production-2024

# Flask environment: development | production | testing
FLASK_ENV=development

# Admin credentials (used only when creating the first admin account at startup)
ADMIN_EMAIL=admin@frauddetect.demo
ADMIN_PASSWORD=Admin@123

# Optional: path overrides (leave blank to use defaults)
# DATABASE_PATH=
# MODEL_PATH=
